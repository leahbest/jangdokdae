{
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 20
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jangdokdae-nine.vercel.app"
        }
      ],
      "destination": "https://www.jangdok.kr/:path*",
      "permanent": true
    }
  ]
}
